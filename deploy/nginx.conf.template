server {
    listen 80;
    root /usr/share/nginx/html;
    absolute_redirect off;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location = / {
        return 302 /assistant/;
    }

    location = /assistant {
        return 301 /assistant/;
    }

    location /assistant/api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/assistant/api/(.*)$ /api/$1 break;
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
        proxy_cookie_path /api/ /assistant/api/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /assistant/ {
        try_files $uri $uri/index.html /assistant/index.html;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }
}
